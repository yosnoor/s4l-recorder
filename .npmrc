# npm >= 12 prints "npm notice run <script>" lines to stderr, which is the same
# stream Jest uses for reporter output. Tools that parse that stream (such as the
# VS Code Jest extension) misread the run as an error. Quieten npm on every
# platform so script output stays machine-readable.
loglevel=warn

# Pin every new dependency to an exact version. Expo SDK packages must stay on
# the patch versions the installed SDK expects, so caret/tilde drift between
# machines is a real source of native build failures.
save-exact=true
